# ═══ REQUIRED IN PRODUCTION ═══════════════════════════════════════════════

# Postgres — Railway attaches this automatically when you add the Postgres
# plugin. Locally you can leave it blank and the app starts an embedded PG.
DATABASE_URL=

# Signs the session cookie. Set to a long random string (at least 32 chars).
SESSION_SECRET=change-me-to-a-long-random-string

# ═══ OPTIONAL — enables Anas (in-portal AI assistant) ═════════════════════

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ═══ OPTIONAL ═════════════════════════════════════════════════════════════

# Public origin — used for links inside emails / notifications.
# PUBLIC_URL=https://bc-portal.up.railway.app

# NODE_ENV is set by Railway to "production" automatically.

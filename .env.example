# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/qcportal

# Session signing secret — set a long random value in production
SESSION_SECRET=change-me

# Password assigned to the default seeded admin (username: admin).
# The user is forced to change it on first login.
ADMIN_DEFAULT_PASSWORD=Qc!Portal_2026_Admin

# Embedded dev database settings (npm run db:start)
PGPORT=5433
PGDATABASE=qcportal
